# Copier ce fichier en .env puis changer les mots de passe : cp .env.example .env
# Ne jamais committer .env (il est dans .gitignore).

# --- PostgreSQL (propriétaire de la base, utilisé par le pipeline et dbt) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hpc_hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change_me

# --- Rôle en lecture seule utilisé par l'API (créé par infra/postgres/init.sql) ---
API_DB_USER=api_reader
API_DB_PASSWORD=change_me_too

# --- dbt ---
DBT_PROFILES_DIR=/app/dbt
DBT_TARGET_PATH=dbt/target

# --- Pipeline ---
DATA_DIR=/app/data
PORTFOLIO_SEED=42

# --- API ---
API_PORT=8000
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
