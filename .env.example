# Copier en .env (ou lancer « make env », qui génère aussi des mots de passe aléatoires).
# Ne jamais committer .env (il est dans .gitignore).

# --- PostgreSQL (propriétaire de la base : pipeline et dbt) ---
# localhost pour travailler depuis WSL ; docker-compose.yml force « postgres » dans les conteneurs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hpc_hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change_me

# --- Rôle en lecture seule de l'API (créé par infra/postgres/init.sql) ---
API_DB_USER=api_reader
API_DB_PASSWORD=change_me_too

# --- Pipeline ---
DATA_DIR=data
PORTFOLIO_SEED=42

# --- API ---
API_PORT=8001
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100

# --- Docker : UID/GID de l'utilisateur hôte (complétés par « make env ») ---
# HOST_UID=1000
# HOST_GID=1000
